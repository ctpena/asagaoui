{
  "name": "asagaoui",
  "description": "AsagaoUI is a CSS framework based on Japan's Digital Agency design system.",
  "version": "0.1.6",
  "homepage": "https://asagaoui.com",
  "author": "Hiroshi ISOBE",
  "license": "MIT",
  "keywords": [
    "css",
    "scss",
    "front-end",
    "framework",
    "css-framework",
    "scss-framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctpena/asagaoui.git"
  },
  "bugs": {
    "url": "https://github.com/ctpena/asagaoui/issues"
  },
  "type": "module",
  "main": "dist/js/asagaoui.min.js",
  "style": "dist/css/asagaoui.min.css",
  "scripts": {
    "sass": "sass ./scss:./dist/css",
    "watch:sass": "sass ./scss:./dist/css --watch",
    "dev:web": "sass ./scss:./website/assets/css --watch",
    "min:sass": "sass ./scss/asagaoui.scss:./dist/css/asagaoui.min.css ./scss/asagaoui-icons.scss:./dist/css/asagaoui-icons.min.css --style=compressed --no-source-map",
    "buildjs": "rollup -c"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/prismjs": "^1.26.5",
    "fantasticon": "^4.1.0",
    "lightningcss": "^1.31.1",
    "prismjs": "^1.30.0",
    "rollup": "^4.57.0",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.97.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/css",
    "dist/icons/asagaoui-icons.woff2",
    "dist/js",
    "scss",
    "ts",
    "NOTICE",
    "LICENSE",
    "README.md"
  ]
}

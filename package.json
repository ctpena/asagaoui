{
  "name": "asagaoui",
  "description": "UI for beautiful and accessible digital services, based on Japan's Digital Agency design system.",
  "version": "0.1.9",
  "homepage": "https://asagaoui.com",
  "author": "Hiroshi ISOBE",
  "license": "MIT",
  "keywords": [
    "html",
    "css",
    "javascript",
    "design-system",
    "ui-library",
    "css-framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctpena/asagaoui.git"
  },
  "bugs": {
    "url": "https://github.com/ctpena/asagaoui/issues"
  },
  "type": "module",
  "main": "./dist/js/asagaoui.js",
  "style": "./dist/css/asagaoui.css",
  "scripts": {
    "sass": "sass ./scss:./dist/css",
    "watch:sass": "sass ./scss:./dist/css --watch",
    "min:sass": "sass ./scss/asagaoui.scss:./dist/css/asagaoui.min.css ./scss/asagaoui-icons.scss:./dist/css/asagaoui-icons.min.css --style=compressed --no-source-map",
    "build": "rolldown ts/asagaoui.ts --file dist/js/asagaoui.js"
  },
  "devDependencies": {
    "prismjs": "^1.30.0",
    "@types/prismjs": "^1.26.6",
    "fantasticon": "^4.1.0",
    "rolldown": "^1.2.0",
    "sass": "^1.102.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/css",
    "dist/icons",
    "dist/js",
    "scss/styles",
    "NOTICE",
    "LICENSE",
    "README.md"
  ]
}
